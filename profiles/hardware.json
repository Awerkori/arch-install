{
  "schema_version": 1,
  "profile_name": "nox-zen4-desktop",
  "cpu": {
    "required_isa": "x86-64-v4",
    "preferred_arch_tier": "znver4",
    "zen_families": [25, 26],
    "fallback_profile": "generic-v4-or-abort"
  },
  "displays": {
    "primary": {
      "preferred_connectors": ["DP-2", "DP-1"],
      "match_model_keywords": ["Odyssey G5", "Samsung"],
      "mode": "2560x1440@165",
      "position": [0, 0],
      "scale": 1.0,
      "transform": "normal",
      "workspace": 1,
      "xwayland_primary": true
    },
    "secondary": {
      "preferred_connectors": ["HDMI-A-1", "HDMI-A-2"],
      "match_model_keywords": ["24B35", "AOC"],
      "mode": "1920x1080@100",
      "fallback_mode": "1920x1080@60",
      "position": [2560, -350],
      "scale": 1.0,
      "transform": "90",
      "workspace": 10
    },
    "vm_fallback": {
      "connectors": ["Virtual-1", "VGA-1", "HDMI-A-1", "DP-1"],
      "scale": 1.0,
      "transform": "normal",
      "position": [0, 0]
    },
    "gaps": 0
  },
  "keyboard": {
    "xkb_layout": "us",
    "xkb_variant": "intl",
    "xkb_options": "",
    "vconsole_keymap": "us-acentos",
    "reference_device": "Aula F75 (Compx 2.4G Wireless Receiver)"
  },
  "audio": {
    "fuxi_h3": {
      "card_id": "FuxiH3",
      "vendor_match": "XiiSound",
      "model_match": "Fuxi-H3",
      "preferred_profile": "output:iec958-stereo+input:mono-fallback",
      "fallback_profile": "output:analog-stereo+input:mono-fallback",
      "mixer_control_name": "PCM Playback Volume",
      "mixer_control_index": 1,
      "mixer_digital_value": 100
    },
    "hushmic": {
      "exclude_source_patterns": ["Monitor of", "HDMI", "Navi", "HushMic", "Dummy"],
      "prefer_source_patterns": ["Analog", "ALC1220", "Ryzen HD Audio", "Realtek"],
      "autostart": true,
      "set_default": true
    }
  },
  "network": {
    "wifi_driver": "iwlwifi",
    "disable_tso_for_driver": "iwlwifi",
    "iwd_disable_roaming_scan": true,
    "tcp_congestion_control": "bbr",
    "default_qdisc": "fq",
    "expected_country": "BR"
  },
  "memory": {
    "zram": {
      "generator": "cachyos-settings",
      "algorithm": "zstd",
      "priority": 100
    },
    "swapfile": {
      "subvolume": "@swap",
      "mountpoint": "/nox-swap",
      "filename": "swapfile",
      "priority": 10,
      "physical_min_ram_gib": 24,
      "physical_size_gib": 32,
      "physical_min_free_gib": 64
    }
  }
}
