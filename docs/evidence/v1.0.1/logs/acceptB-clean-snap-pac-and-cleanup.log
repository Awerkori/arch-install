=== launcher keybind in umbriel config ===
autostart = ["sh -c '/usr/local/libexec/nox/nox-noctalia-layout --init-once >/dev/null 2>&1 || true; exec noctalia'"]
"Mod+Q" = { action = "spawn kitty", repeat = false }
"Mod+E" = { action = "spawn luciole", repeat = false }
"Mod" = "spawn noctalia msg panel-toggle launcher"
"Mod+R" = { action = "spawn noctalia msg panel-toggle launcher", repeat = false }
"Mod+M" = { action = "session-quit", repeat = false }
"Mod+Escape" = { action = "spawn noctalia msg panel-toggle session", repeat = false }
"Mod+L" = { action = "spawn noctalia msg session lock", repeat = false }
"Mod+D" = { action = "spawn noctalia msg panel-toggle control-center", repeat = false }
"Mod+V" = { action = "spawn noctalia msg panel-toggle clipboard", repeat = false }
"Mod+Period" = { action = "spawn noctalia msg panel-toggle launcher /emo", repeat = false }
"Mod+Comma" = { action = "spawn noctalia msg panel-toggle wallpaper", repeat = false }
"Mod+Tab" = { action = "overview-toggle", repeat = false }
"Mod+Shift+C" = { action = "spawn noctalia msg settings-toggle", repeat = false }
"Mod+Shift+S" = { action = "spawn noctalia msg screenshot-region", repeat = false }
"Mod+Shift+A" = { action = "spawn noctalia msg screenshot-annotate", repeat = false }
"Mod+Shift+B" = { action = "spawn noctalia msg bar-toggle", repeat = false }
"Mod+Alt+B" = { action = "spawn sh -c 'umbriel msg config-reload && noctalia msg config-reload'", repeat = false }
"Mod+C" = { action = "window-close", repeat = false }
"Mod+Space" = { action = "window-toggle-floating", repeat = false }
"Mod+F" = { action = "window-toggle-fullscreen", repeat = false }
"Mod+Shift+F" = { action = "window-toggle-maximize-to-edges", repeat = false }
"Mod+Ctrl+F" = { action = "window-toggle-maximize", repeat = false }
"Mod+J" = { action = "layout-toggle-split", repeat = false }
"Mod+Ctrl+Space" = { action = "window-center", repeat = false }
