{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Nox Archinstall — Project Nox Obsidian Purple Dashboard
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/nox-logo.txt",
    "padding": {
      "top": 2,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "disableLinewrap": true,
    "separator": " │ ",
    "color": {
      "keys": "38;2;196;181;253",
      "title": "38;2;251;191;36",
      "output": "38;2;245;242;255",
      "separator": "38;2;168;85;247"
    },
    "key": {
      "width": 13
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "\u001b[1;38;2;251;191;36m{user-name}\u001b[38;2;124;58;237m@\u001b[1;38;2;168;85;247m{host-name}\u001b[0m"
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;251;191;36m✦ \u001b[1;38;2;168;85;247mSYSTEM\u001b[0m"
    },
    {
      "type": "os",
      "key": "├─ OS"
    },
    {
      "type": "host",
      "key": "├─ Host"
    },
    {
      "type": "kernel",
      "key": "├─ Kernel"
    },
    {
      "type": "uptime",
      "key": "├─ Uptime"
    },
    {
      "type": "packages",
      "key": "└─ Packages"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;251;191;36m✦ \u001b[1;38;2;168;85;247mSESSION\u001b[0m"
    },
    {
      "type": "shell",
      "key": "├─ Shell"
    },
    {
      "type": "wm",
      "key": "├─ WM"
    },
    {
      "type": "de",
      "key": "├─ Desktop",
      "format": "Noctalia Shell"
    },
    {
      "type": "terminal",
      "key": "├─ Terminal"
    },
    {
      "type": "locale",
      "key": "└─ Locale"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;251;191;36m✦ \u001b[1;38;2;168;85;247mHARDWARE\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "├─ CPU",
      "format": "{name} ({cores-logical}c)"
    },
    {
      "type": "gpu",
      "key": "├─ GPU",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "├─ Memory"
    },
    {
      "type": "swap",
      "key": "└─ Swap"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;251;191;36m✦ \u001b[1;38;2;168;85;247mDISPLAY & STORAGE\u001b[0m"
    },
    {
      "type": "display",
      "key": "├─ Display",
      "compactType": "original-with-refresh-rate"
    },
    {
      "type": "disk",
      "key": "└─ Disk (/)",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
