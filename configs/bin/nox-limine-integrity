#!/usr/bin/env bash
# Transactional repair / verification helper for Limine config normalization, BLAKE2b enrollment, and sbctl signatures.
set -Eeuo pipefail

MODE="${1:---repair-if-dirty}"
case "$MODE" in
  --repair-if-dirty | --repair | --force | --verify | --check) ;;
  *)
    echo "Uso: $0 [--repair-if-dirty|--repair|--force|--verify|--check]" >&2
    exit 2
    ;;
esac

ESP="${ESP_PATH:-/boot}"
if [[ -z "${ESP_PATH:-}" ]] && ! findmnt "$ESP" >/dev/null 2>&1 && findmnt /efi >/dev/null 2>&1; then
  ESP="/efi"
fi
export ESP_PATH="$ESP"

CONF="${ESP}/limine.conf"
DIRTY_MARKER="${NOX_DIRTY_MARKER:-/run/nox-limine-tx.dirty}"
LIMINE_DEFAULT="${NOX_LIMINE_DEFAULT:-/etc/default/limine}"
LIMINE_EFI="${ESP}/EFI/limine/limine_x64.efi"
FALLBACK_EFI="${ESP}/EFI/BOOT/BOOTX64.EFI"
NORMALIZE_BIN="${NOX_NORMALIZE_BIN:-/usr/local/libexec/nox/nox-limine-normalize}"
LIMINE_ENROLL_BIN="${NOX_LIMINE_ENROLL_BIN:-limine-enroll-config}"
FALLBACK_HOOK="${NOX_FALLBACK_HOOK:-/etc/boot/hooks/post.d/95-nox-sbctl-fallback}"
VERIFY_BIN="${NOX_VERIFY_BIN:-/usr/local/bin/nox-secureboot-verify}"
SBCTL_BIN="${NOX_SBCTL_BIN:-sbctl}"

if [[ ! -f "$CONF" ]]; then
  if [[ -f "$DIRTY_MARKER" ]]; then
    echo "nox-limine-integrity: ERRO CRITICO — $CONF ausente durante transacao interrompida ($DIRTY_MARKER preservado)." >&2
    exit 1
  fi
  if [[ "$MODE" == "--force" || "$MODE" == "--repair" || "$MODE" == "--verify" || "$MODE" == "--check" ]]; then
    echo "nox-limine-integrity: ERRO CRITICO — configuracao obrigatoria ausente ($CONF) para modo ${MODE}." >&2
    exit 1
  fi
  if [[ -s "$LIMINE_EFI" || -s "$FALLBACK_EFI" || -f "$LIMINE_DEFAULT" ]]; then
    echo "nox-limine-integrity: ERRO CRITICO — instalacao do Limine detectada, mas $CONF esta ausente." >&2
    exit 1
  fi
  exit 0
fi

_is_config_normalized() {
  ! grep -Eq '^[[:space:]]*//linux-cachyos$|^[[:space:]]*///[0-9]+[[:space:]]*\||^[[:space:]]*/\+Snapshots\b' "$CONF" || return 1
  if grep -Eq '^[[:space:]]*/\+Arch Linux' "$CONF" && ! grep -Eq '^[[:space:]]*//Project Nox$' "$CONF"; then
    return 1
  fi
  if [[ -f "${ESP}/nox-limine-wallpaper.png" ]] && grep -q '^wallpaper: boot():/nox-limine-wallpaper\.png#' "$CONF"; then
    local wp_b2
    wp_b2="$(b2sum "${ESP}/nox-limine-wallpaper.png" 2>/dev/null | awk '{print $1}' || true)"
    if [[ -n "$wp_b2" ]] && ! grep -qiF "wallpaper: boot():/nox-limine-wallpaper.png#${wp_b2}" "$CONF"; then
      return 1
    fi
  fi
  return 0
}

_are_blake2b_enrolled() {
  if ! grep -qE '^[[:space:]]*ENABLE_ENROLL_LIMINE_CONFIG=yes' "$LIMINE_DEFAULT" 2>/dev/null; then
    return 0
  fi
  [[ -s "$LIMINE_EFI" && -s "$FALLBACK_EFI" ]] || return 1
  local conf_b2
  conf_b2="$(b2sum "$CONF" 2>/dev/null | awk '{print $1}' || true)"
  [[ -n "$conf_b2" ]] || return 1
  grep -qaiF "$conf_b2" "$LIMINE_EFI" 2>/dev/null || return 1
  grep -qaiF "$conf_b2" "$FALLBACK_EFI" 2>/dev/null || return 1
  return 0
}

_are_efi_binaries_signed() {
  command -v "$SBCTL_BIN" >/dev/null 2>&1 || return 1
  "$SBCTL_BIN" setup --print-state --json 2>/dev/null | grep -q '"installed": true' || return 1
  local efi
  for efi in "$LIMINE_EFI" "$FALLBACK_EFI"; do
    [[ -s "$efi" ]] || return 1
    "$SBCTL_BIN" verify "$efi" 2>/dev/null | grep -q 'is signed' || return 1
  done
  return 0
}

if [[ "$MODE" == "--verify" || "$MODE" == "--check" ]]; then
  if [[ -f "$DIRTY_MARKER" ]]; then
    echo "nox-limine-integrity: ERRO CRITICO — marcador de transacao pendente encontrado ($DIRTY_MARKER)." >&2
    exit 1
  fi
  if ! _is_config_normalized; then
    echo "nox-limine-integrity: ERRO CRITICO — $CONF nao esta normalizado." >&2
    exit 1
  fi
  if ! _are_blake2b_enrolled; then
    echo "nox-limine-integrity: ERRO CRITICO — hash BLAKE2B de $CONF ausente ou divergente nos binarios EFI." >&2
    exit 1
  fi
  if ! _are_efi_binaries_signed; then
    echo "nox-limine-integrity: ERRO CRITICO — assinatura EFI sbctl invalida ou ausente." >&2
    exit 1
  fi
  exec "$VERIFY_BIN" \
    --esp-path "$ESP" \
    --limine-default "$LIMINE_DEFAULT" \
    --dirty-marker "$DIRTY_MARKER" \
    --sbctl-bin "$SBCTL_BIN"
fi

needs_repair=false
if [[ "$MODE" == "--force" || "$MODE" == "--repair" ]]; then
  needs_repair=true
elif [[ -f "$DIRTY_MARKER" ]]; then
  needs_repair=true
elif ! _is_config_normalized; then
  needs_repair=true
elif ! _are_blake2b_enrolled; then
  needs_repair=true
elif ! _are_efi_binaries_signed; then
  needs_repair=true
fi

$needs_repair || exit 0

if ((EUID != 0)) && [[ "${NOX_ALLOW_NONROOT_TEST:-0}" != "1" ]]; then
  echo "nox-limine-integrity: privilegios root obrigatorios para reparar $CONF" >&2
  exit 1
fi

# Preflight all mandatory recovery dependencies BEFORE mutating any file (preserve dirty marker on failure)
fail_preflight() {
  echo "nox-limine-integrity: ERRO CRITICO (preflight): $*" >&2
  exit 1
}

[[ -x "$NORMALIZE_BIN" ]] || fail_preflight "normalizador ausente ou sem permissao de execucao: $NORMALIZE_BIN"
command -v "$LIMINE_ENROLL_BIN" >/dev/null 2>&1 || fail_preflight "comando obrigatorio ausente no PATH: $LIMINE_ENROLL_BIN"
[[ -x "$FALLBACK_HOOK" ]] || fail_preflight "hook de fallback ausente ou sem permissao de execucao: $FALLBACK_HOOK"
[[ -x "$VERIFY_BIN" ]] || command -v "$VERIFY_BIN" >/dev/null 2>&1 || fail_preflight "verificador obrigatorio ausente: $VERIFY_BIN"
command -v "$SBCTL_BIN" >/dev/null 2>&1 || fail_preflight "sbctl ausente: $SBCTL_BIN"
command -v b2sum >/dev/null 2>&1 || fail_preflight "b2sum ausente"

# Step 1: Normalize /boot/limine.conf
if ! "$NORMALIZE_BIN" --post --file "$CONF" --esp-dir "$ESP"; then
  echo "nox-limine-integrity: ERRO CRITICO ao normalizar $CONF" >&2
  exit 1
fi

# Step 2: Enroll BLAKE2B of limine.conf and sign primary EFI binary
if ! "$LIMINE_ENROLL_BIN"; then
  echo "nox-limine-integrity: ERRO CRITICO ao executar $LIMINE_ENROLL_BIN" >&2
  exit 1
fi

# Step 3: Update and sign fallback BOOTX64.EFI without clearing dirty marker prematurely
if ! NOX_PRESERVE_DIRTY_MARKER=1 "$FALLBACK_HOOK"; then
  echo "nox-limine-integrity: ERRO CRITICO ao executar hook de fallback $FALLBACK_HOOK" >&2
  exit 1
fi

# Step 4: Re-verify ALL post-conditions before declaring transaction clean
if ! _is_config_normalized; then
  echo "nox-limine-integrity: ERRO CRITICO pos-reparo — $CONF nao ficou normalizado." >&2
  exit 1
fi

if ! _are_blake2b_enrolled; then
  echo "nox-limine-integrity: ERRO CRITICO pos-reparo — hash BLAKE2B de $CONF nao confere em $LIMINE_EFI / $FALLBACK_EFI." >&2
  exit 1
fi

if ! _are_efi_binaries_signed; then
  echo "nox-limine-integrity: ERRO CRITICO pos-reparo — assinatura EFI sbctl invalida ou ausente." >&2
  exit 1
fi

if ! "$VERIFY_BIN" \
  --esp-path "$ESP" \
  --limine-default "$LIMINE_DEFAULT" \
  --dirty-marker "$DIRTY_MARKER" \
  --ignore-dirty-marker \
  --sbctl-bin "$SBCTL_BIN"; then
  echo "nox-limine-integrity: ERRO CRITICO pos-reparo — $VERIFY_BIN reprovou a cadeia de boot." >&2
  exit 1
fi

# Step 5: Flush storage before atomically removing dirty marker
sync -f "$CONF" 2>/dev/null || sync
sync -f "$LIMINE_EFI" 2>/dev/null || sync
sync -f "$FALLBACK_EFI" 2>/dev/null || sync
rm -f "$DIRTY_MARKER"
sync
