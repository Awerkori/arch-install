#!/usr/bin/env python3
"""Select physical microphone safely for HushMic without HDMI/Monitor/loopback traps."""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path
from typing import Any


EXCLUDED_TERMS = ("monitor of", "hdmi", "navi", "hushmic", "dummy", "null")
PREFERRED_TERMS = ("analog", "alc1220", "ryzen hd audio", "realtek", "mic")


def score_device(dev: dict[str, Any]) -> int:
    name = str(dev.get("name", ""))
    desc = str(dev.get("description", ""))
    combined = f"{name} {desc}".lower()
    if any(term in combined for term in EXCLUDED_TERMS):
        return -1000
    score = 10
    for idx, term in enumerate(PREFERRED_TERMS):
        if term in combined:
            score += 100 - idx * 10
    if "usb" in combined:
        score += 5
    return score


def select_best_mic(devices: list[dict[str, Any]]) -> str | None:
    candidates = [(score_device(d), str(d.get("name", ""))) for d in devices if d.get("name")]
    valid = [c for c in candidates if c[0] > 0]
    if not valid:
        return None
    valid.sort(key=lambda item: item[0], reverse=True)
    return valid[0][1]


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--devices-json", type=Path, default=None)
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    devices: list[dict[str, Any]] = []
    if args.devices_json:
        raw = json.loads(args.devices_json.read_text(encoding="utf-8"))
        devices = raw if isinstance(raw, list) else raw.get("devices", [])
    else:
        try:
            res = subprocess.run(
                ["hushmic", "devices", "--json"],
                capture_output=True,
                text=True,
                timeout=8,
                check=False,
            )
            if res.returncode == 0 and res.stdout.strip():
                raw = json.loads(res.stdout)
                devices = raw if isinstance(raw, list) else raw.get("devices", [])
        except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
            devices = []

    chosen = select_best_mic(devices)
    if args.dry_run:
        print(json.dumps({"selected_mic": chosen or "default", "candidate_count": len(devices)}))
        return 0

    if not shutil_which("hushmic"):
        print("SKIP-HARDWARE: hushmic binario ausente.", file=sys.stderr)
        return 0

    cmds = [
        ["hushmic", "config", "set", "autostart", "true"],
        ["hushmic", "config", "set", "set_default", "true"],
        ["hushmic", "config", "set", "mic", chosen or "default"],
    ]
    for cmd in cmds:
        subprocess.run(cmd, check=False, timeout=8)
    return 0


def shutil_which(cmd: str) -> str | None:
    import shutil
    return shutil.which(cmd)


if __name__ == "__main__":
    raise SystemExit(main())
