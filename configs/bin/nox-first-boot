#!/usr/bin/env bash
# Runs once on real booted system (system context) for boot-time-only checks.
set -Eeuo pipefail

STATE_DIR="/var/lib/nox-archinstall"
DONE_FILE="${STATE_DIR}/first-boot.done"
mkdir -p "$STATE_DIR"

if [[ -f "$DONE_FILE" ]]; then
  exit 0
fi

# 1. Ensure sysctl settings (BBR/fq + cachyos-settings) are applied
modprobe tcp_bbr >/dev/null 2>&1 || true
sysctl --system >/dev/null 2>&1 || true

# 2. Conditional Wi-Fi regulatory domain remediation (only if self-managed + country BR)
if command -v iw >/dev/null 2>&1; then
  REG_OUT="$(iw reg get 2>/dev/null || true)"
  if printf '%s\n' "$REG_OUT" | grep -q '(self-managed)' &&
    printf '%s\n' "$REG_OUT" | grep -q 'country BR:'; then
    if systemctl is-failed --quiet cachyos-iw-set-regdomain.service 2>/dev/null ||
      systemctl list-unit-files cachyos-iw-set-regdomain.service >/dev/null 2>&1; then
      systemctl mask cachyos-iw-set-regdomain.service >/dev/null 2>&1 || true
      systemctl mask cachyos-iw-set-regdomain.path >/dev/null 2>&1 || true
      systemctl reset-failed cachyos-iw-set-regdomain.service >/dev/null 2>&1 || true
      echo "Masked redundant cachyos-iw-set-regdomain (self-managed PHY with country BR)."
    fi
  fi
fi

# 3. Verify Limine configuration on booted target
if command -v limine-snapper-sync >/dev/null 2>&1 && [[ -f /boot/limine.conf ]]; then
  if ! grep -q 'linux-cachyos' /boot/limine.conf; then
    limine-update || true
  fi
  limine-snapper-sync || true
  if [[ -x /usr/local/libexec/nox/nox-limine-normalize ]]; then
    /usr/local/libexec/nox/nox-limine-normalize --post || true
  fi
  command -v limine-enroll-config >/dev/null 2>&1 && limine-enroll-config >/dev/null 2>&1 || true
  [[ -x /etc/boot/hooks/post.d/95-nox-sbctl-fallback ]] && /etc/boot/hooks/post.d/95-nox-sbctl-fallback >/dev/null 2>&1 || true
fi

# 4. Optimize Btrfs mount options in /etc/fstab (add noatime cleanly; deduplicate /nox-swap and /.snapshots)
if [[ -f /etc/fstab ]]; then
  python3 - /etc/fstab <<'PY'
import os, sys
p = sys.argv[1]
lines = open(p, "r", encoding="utf-8").read().splitlines()
out, seen_mounts = [], set()
for line in lines:
    stripped = line.strip()
    if not stripped or stripped.startswith("#"):
        out.append(line)
        continue
    parts = stripped.split()
    if len(parts) >= 4 and parts[1] in ("/nox-swap", "/.snapshots"):
        if parts[1] in seen_mounts:
            continue
        seen_mounts.add(parts[1])
    if len(parts) >= 4 and parts[2] == "btrfs":
        opts = [o for o in parts[3].split(",") if o]
        if "noatime" not in opts and "atime" not in opts:
            opts = [o for o in opts if o != "relatime"]
            opts.append("noatime")
        parts[3] = ",".join(opts)
        out.append(" ".join(parts))
    else:
        out.append(line)
tmp = p + ".nox.tmp"
with open(tmp, "w", encoding="utf-8") as f:
    f.write("\n".join(out) + "\n")
os.replace(tmp, p)
PY
fi

date -Iseconds >"$DONE_FILE"
systemctl disable nox-first-boot.service >/dev/null 2>&1 || true
