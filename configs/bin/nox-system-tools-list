#!/usr/bin/env python3
"""List hidden technical system tools for Noctalia's global search dmenu provider.

Reads ~/.local/share/applications/*.desktop entries marked NoDisplay=true and
resolves their corresponding system /usr/share/applications/<id> metadata so
technical tools stay out of the initial launcher list while remaining searchable
and launchable by name whenever installed.
"""
from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path


def parse_desktop_entry(path: Path) -> dict[str, str]:
    data: dict[str, str] = {}
    in_main = False
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return data
    for raw in lines:
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("[") and line.endswith("]"):
            if in_main:
                break
            in_main = line == "[Desktop Entry]"
            continue
        if in_main and "=" in line:
            k, v = line.split("=", 1)
            key = k.strip()
            if "[" not in key and key not in data:
                data[key] = v.strip()
    return data


def collect_hidden_tools(user_dir: Path, sys_dir: Path) -> list[tuple[str, str, str]]:
    if not user_dir.is_dir():
        return []
    entries: list[tuple[str, str, str]] = []
    for ov in sorted(user_dir.glob("*.desktop")):
        ov_data = parse_desktop_entry(ov)
        if ov_data.get("NoDisplay", "").lower() != "true":
            continue
        sys_file = sys_dir / ov.name
        if not sys_file.is_file():
            continue
        sys_data = parse_desktop_entry(sys_file)
        if sys_data.get("NoDisplay", "").lower() == "true":
            continue
        name = sys_data.get("Name") or ov_data.get("Name") or ov.stem
        desc = sys_data.get("Comment") or sys_data.get("GenericName") or "System Tool"
        entries.append((name, desc, ov.name))
    entries.sort(key=lambda item: item[0].lower())
    return entries


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description="List hidden technical tools for Noctalia search.")
    parser.add_argument(
        "--user-dir",
        default=str(Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "applications"),
    )
    parser.add_argument("--sys-dir", default="/usr/share/applications")
    args = parser.parse_args(argv)

    for name, desc, _desktop_id in collect_hidden_tools(Path(args.user_dir), Path(args.sys_dir)):
        clean_name = name.replace("\t", " ").replace("\n", " ").strip()
        clean_desc = desc.replace("\t", " ").replace("\n", " ").strip()
        print(f"{clean_name}\t{clean_desc}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
