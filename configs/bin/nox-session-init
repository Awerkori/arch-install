#!/usr/bin/env bash
# User session initializer: display profile, dark mode, Noctalia animated/lockscreen layout, Firefox Pure CSS, XDG mime, Fuxi H3.
set -Eeuo pipefail

# 1. Generate dynamic display outputs.toml for Umbriel
/usr/local/libexec/nox/nox-display-profile || true
if command -v umbriel >/dev/null 2>&1 && [[ -n "${UMBRIEL_SOCKET:-}" ]]; then
  umbriel msg config-reload >/dev/null 2>&1 || true
  sleep 0.3
fi

# 2. Apply GSettings dark mode (requires D-Bus user session)
if command -v gsettings >/dev/null 2>&1; then
  gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3-dark' >/dev/null 2>&1 || true
  gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' >/dev/null 2>&1 || true
fi

# 3. Apply Project Nox Obsidian Purple identity, lockscreen widgets, animated mpvpaper & templates once
#    and auto-refresh connector layout if physical monitor ports changed (e.g. DP-2 -> DP-1).
NOX_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
NOX_INIT_MARKER="${NOX_STATE_DIR}/noctalia/.nox-obsidian-init-v2"
MPV_ASSIGN_FILE="${NOX_STATE_DIR}/noctalia/mpvpaper/assignments.json"

nox_mpv_layout_stale() {
  [[ -f "$MPV_ASSIGN_FILE" ]] || return 0
  python3 - "$MPV_ASSIGN_FILE" <<'PY' >/dev/null 2>&1 || return 0
import json, subprocess, sys
from pathlib import Path
cur = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8")).get("assignments", {})
res = subprocess.run(["umbriel", "outputs", "--json"], capture_output=True, text=True, timeout=3)
outs = json.loads(res.stdout) if res.returncode == 0 and res.stdout.strip() else []
names = {str(o.get("name", "")) for o in outs if o.get("name")}
if not names:
    sys.exit(0)
# Stale if current keys omit an active output or hold an absent concrete connector
if any(k != "*" and k not in names for k in cur) or not names.issubset(set(cur)):
    sys.exit(1)
sys.exit(0)
PY
}

if [[ ! -f "$NOX_INIT_MARKER" ]]; then
  mkdir -p "$(dirname "$NOX_INIT_MARKER")"
  /usr/local/libexec/nox/nox-noctalia-layout >/dev/null 2>&1 || true

  if command -v noctalia >/dev/null 2>&1; then
    for _ in $(seq 1 40); do
      if noctalia msg wallpaper-get >/dev/null 2>&1; then
        break
      fi
      sleep 0.5
    done
    if [[ -f /usr/share/nox-archinstall/wallpapers/obsidian-purple.png ]]; then
      noctalia msg wallpaper-set /usr/share/nox-archinstall/wallpapers/obsidian-purple.png >/dev/null 2>&1 || true
    fi
    noctalia msg templates-apply >/dev/null 2>&1 || true
    noctalia msg config-reload >/dev/null 2>&1 || true
    noctalia msg plugin noctalia/mpvpaper:service all reapply >/dev/null 2>&1 || true
  fi
  touch "$NOX_INIT_MARKER"
elif nox_mpv_layout_stale; then
  /usr/local/libexec/nox/nox-noctalia-layout >/dev/null 2>&1 || true
  if command -v noctalia >/dev/null 2>&1; then
    noctalia msg config-reload >/dev/null 2>&1 || true
    noctalia msg plugin noctalia/mpvpaper:service all reapply >/dev/null 2>&1 || true
  fi
fi

# 4. Harmonize Firefox Pure toolbar/tabs (userChrome/userContent) for all profiles
if [[ -f /usr/share/nox-archinstall/firefox/userChrome.css ]]; then
  FF_DIR="$HOME/.mozilla/firefox"
  if [[ ! -f "${FF_DIR}/profiles.ini" ]] && command -v firefox >/dev/null 2>&1; then
    timeout 10 firefox --headless --no-remote -CreateProfile "nox ${FF_DIR}/nox.default" >/dev/null 2>&1 || true
  fi
  if [[ -d "$FF_DIR" ]]; then
    for prof in "${FF_DIR}"/*/; do
      [[ -d "$prof" ]] || continue
      base="$(basename "$prof")"
      case "$base" in
        Crash*|Pending*) continue ;;
      esac
      mkdir -p "${prof}chrome"
      if [[ ! -f "${prof}chrome/userChrome.css" ]]; then
        install -m 0644 /usr/share/nox-archinstall/firefox/userChrome.css "${prof}chrome/userChrome.css"
      fi
      if [[ ! -f "${prof}chrome/userContent.css" && -f /usr/share/nox-archinstall/firefox/userContent.css ]]; then
        install -m 0644 /usr/share/nox-archinstall/firefox/userContent.css "${prof}chrome/userContent.css"
      fi
    done
  fi
fi

# 5. Ensure Luciole (directories) and Firefox Pure (HTTP/HTTPS/HTML) are XDG defaults
if command -v xdg-mime >/dev/null 2>&1; then
  if [[ -f /usr/share/applications/dev.noctalia.luciole.desktop ]]; then
    xdg-mime default dev.noctalia.luciole.desktop inode/directory >/dev/null 2>&1 || true
  fi
  if [[ -f /usr/share/applications/firefox.desktop ]]; then
    xdg-mime default firefox.desktop \
      x-scheme-handler/http \
      x-scheme-handler/https \
      x-scheme-handler/about \
      x-scheme-handler/unknown \
      text/html \
      application/xhtml+xml >/dev/null 2>&1 || true
  fi
fi
if command -v xdg-settings >/dev/null 2>&1 && [[ -f /usr/share/applications/firefox.desktop ]]; then
  xdg-settings set default-web-browser firefox.desktop >/dev/null 2>&1 || true
fi

# 6. Seed missing topgrade drop-ins without overwriting user preferences
if [[ -d /etc/skel/.config/topgrade.d ]]; then
  mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/topgrade.d"
  for tgcfg in /etc/skel/.config/topgrade.d/*.toml; do
    [[ -f "$tgcfg" ]] || continue
    base="$(basename "$tgcfg")"
    if [[ ! -f "${XDG_CONFIG_HOME:-$HOME/.config}/topgrade.d/${base}" ]]; then
      install -m 0644 "$tgcfg" "${XDG_CONFIG_HOME:-$HOME/.config}/topgrade.d/${base}"
    fi
  done
fi

# 7. Dynamic Fuxi H3 fix (skips cleanly if headset absent)
/usr/local/libexec/nox/nox-fuxi-h3-fix >/dev/null 2>&1 || true
