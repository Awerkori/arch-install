#!/usr/bin/env python3
"""Generate Umbriel ~/.config/umbriel/outputs.toml from hardware profile and live outputs."""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path
from typing import Any


DEFAULT_PROFILE = Path("/etc/nox-archinstall/hardware.json")
DEFAULT_OUT = Path.home() / ".config/umbriel/outputs.toml"


def load_outputs_from_umbriel() -> list[dict[str, Any]]:
    try:
        res = subprocess.run(
            ["umbriel", "outputs", "--json"],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
        if res.returncode == 0 and res.stdout.strip():
            data = json.loads(res.stdout)
            if isinstance(data, list):
                return data
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
        pass
    return []


def _parse_edid_text(edid_bytes: bytes) -> str:
    """Extract readable ASCII monitor/vendor descriptor strings from a 128+ byte DRM EDID blob."""
    if len(edid_bytes) < 128:
        return ""
    tokens: list[str] = []
    # 4 detailed descriptor blocks at offsets 54, 72, 90, 108; tags 0xfc (name) and 0xfe (string)
    for off in (54, 72, 90, 108):
        blk = edid_bytes[off : off + 18]
        if len(blk) == 18 and blk[:3] == b"\x00\x00\x00" and blk[3] in (0xFC, 0xFE):
            txt = blk[5:18].split(b"\n", 1)[0].decode("ascii", errors="ignore").strip()
            if txt:
                tokens.append(txt)
    return " ".join(tokens)


def load_outputs_from_sysfs(drm_root: Path = Path("/sys/class/drm")) -> list[dict[str, Any]]:
    outputs: list[dict[str, Any]] = []
    if not drm_root.is_dir():
        return outputs
    for status_file in sorted(drm_root.glob("card*-*/status")):
        try:
            if status_file.read_text().strip() != "connected":
                continue
        except OSError:
            continue
        conn_dir = status_file.parent
        name = conn_dir.name.split("-", 1)[1] if "-" in conn_dir.name else conn_dir.name
        modes_file = conn_dir / "modes"
        modes = []
        if modes_file.is_file():
            try:
                modes = [m.strip() for m in modes_file.read_text().splitlines() if m.strip()]
            except OSError:
                modes = []
        edid_desc = ""
        edid_file = conn_dir / "edid"
        if edid_file.is_file():
            try:
                edid_desc = _parse_edid_text(edid_file.read_bytes())
            except OSError:
                edid_desc = ""
        entry: dict[str, Any] = {"name": name, "modes": modes, "connected": True}
        if edid_desc:
            entry["model"] = edid_desc
        outputs.append(entry)
    return outputs


def pick_best_mode(advertised: list[Any], wanted: str, fallback: str | None = None) -> str | None:
    if not advertised:
        return None
    str_modes: list[str] = []
    for m in advertised:
        if isinstance(m, str):
            str_modes.append(m)
        elif isinstance(m, dict):
            w, h = m.get("width"), m.get("height")
            hz = m.get("refresh_hz") or m.get("refresh") or m.get("refresh_rate")
            if w and h:
                if hz:
                    hz_val = float(hz)
                    if hz_val > 1000:
                        hz_val /= 1000.0
                    str_modes.append(f"{w}x{h}@{hz_val:.3f}".rstrip("0").rstrip("."))
                str_modes.append(f"{w}x{h}")
    if wanted in str_modes:
        return wanted
    if "@" in wanted:
        base, hz_str = wanted.split("@", 1)
        try:
            target_hz = float(hz_str)
            for m in str_modes:
                if m.startswith(base + "@"):
                    mhz = float(m.split("@", 1)[1])
                    if abs(mhz - target_hz) <= 1.5:
                        return m
        except ValueError:
            pass
    if fallback and fallback in str_modes:
        return fallback
    res_prefix = wanted.split("@", 1)[0]
    for m in str_modes:
        if m.startswith(res_prefix):
            return m
    return str_modes[0] if str_modes else None


def _match_by_keywords(out: dict[str, Any], spec: dict[str, Any]) -> bool:
    desc = " ".join(
        str(out.get(k, "")) for k in ("make", "model", "config_name", "description")
    ).lower()
    keywords = [k.lower() for k in spec.get("match_model_keywords", [])]
    return bool(keywords and any(k in desc for k in keywords))


def matches_output(out: dict[str, Any], spec: dict[str, Any]) -> bool:
    if _match_by_keywords(out, spec):
        return True
    name = str(out.get("name", ""))
    return name in spec.get("preferred_connectors", [])


def _select_output(
    outputs: list[dict[str, Any]],
    spec: dict[str, Any],
    exclude: dict[str, Any] | None = None,
) -> dict[str, Any] | None:
    pool = [o for o in outputs if o is not exclude]
    # Priority 1: hardware EDID/model match independent of enumeration order
    by_model = next((o for o in pool if _match_by_keywords(o, spec)), None)
    if by_model is not None:
        return by_model
    # Priority 2: preferred_connectors in explicit priority order (e.g. DP-1 before DP-2)
    for conn in spec.get("preferred_connectors", []):
        by_conn = next((o for o in pool if str(o.get("name", "")) == conn), None)
        if by_conn is not None:
            return by_conn
    return None


def render_outputs_toml(outputs: list[dict[str, Any]], profile: dict[str, Any]) -> str:
    disp = profile.get("displays", {})
    prim_spec = disp.get("primary", {})
    sec_spec = disp.get("secondary", {})

    lines = [
        "# Auto-generated by nox-display-profile (do not edit manually; overridden on login)",
        "",
    ]

    if not outputs:
        lines.append("# No active outputs reported; relying on Umbriel automatic output defaults.")
        return "\n".join(lines) + "\n"

    prim_out = _select_output(outputs, prim_spec)
    sec_out = _select_output(outputs, sec_spec, exclude=prim_out)

    # Physical dual or primary match vs VM / single output fallback
    if prim_out and not str(prim_out.get("name", "")).startswith(("Virtual-", "VGA-")):
        pname = prim_out["name"]
        pmode = pick_best_mode(prim_out.get("modes", []), prim_spec.get("mode", "2560x1440@165"))
        lines.append("[general]")
        lines.append(f'xwayland_primary_output = "{pname}"')
        lines.append("")
        lines.append(f'[output."{pname}"]')
        lines.append("enabled = true")
        if pmode:
            lines.append(f'mode = "{pmode}"')
        pos = prim_spec.get("position", [0, 0])
        lines.append(f"position = [{int(pos[0])}, {int(pos[1])}]")
        lines.append(f"scale = {float(prim_spec.get('scale', 1.0))}")
        lines.append(f'transform = "{prim_spec.get("transform", "normal")}"')
        lines.append("focus_at_startup = true")
        lines.append("")

        if sec_out:
            sname = sec_out["name"]
            smode = pick_best_mode(
                sec_out.get("modes", []),
                sec_spec.get("mode", "1920x1080@100"),
                sec_spec.get("fallback_mode", "1920x1080@60"),
            )
            spos = sec_spec.get("position", [2560, -350])
            lines.append(f'[output."{sname}"]')
            lines.append("enabled = true")
            if smode:
                lines.append(f'mode = "{smode}"')
            lines.append(f"position = [{int(spos[0])}, {int(spos[1])}]")
            lines.append(f"scale = {float(sec_spec.get('scale', 1.0))}")
            lines.append(f'transform = "{sec_spec.get("transform", "90")}"')
            lines.append("")
    else:
        # Safe single-output / VM fallback: never hardcode disconnected DP-1/DP-2/HDMI-A-1
        first = outputs[0]
        fname = first.get("name", "Virtual-1")
        lines.append("[general]")
        lines.append(f'xwayland_primary_output = "{fname}"')
        lines.append("")
        lines.append(f'[output."{fname}"]')
        lines.append("enabled = true")
        lines.append("position = [0, 0]")
        lines.append("scale = 1.0")
        lines.append('transform = "normal"')
        lines.append("focus_at_startup = true")
        lines.append("")

    return "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--profile", type=Path, default=DEFAULT_PROFILE)
    parser.add_argument("--output", type=Path, default=DEFAULT_OUT)
    parser.add_argument("--input-json", type=Path, default=None)
    parser.add_argument("--drm-root", type=Path, default=Path("/sys/class/drm"))
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    profile: dict[str, Any] = {}
    if args.profile.is_file():
        profile = json.loads(args.profile.read_text(encoding="utf-8"))

    if args.input_json:
        outputs = json.loads(args.input_json.read_text(encoding="utf-8"))
    else:
        outputs = load_outputs_from_umbriel() or load_outputs_from_sysfs(args.drm_root)

    content = render_outputs_toml(outputs, profile)
    if args.dry_run:
        sys.stdout.write(content)
        return 0

    if (
        not args.dry_run
        and args.output.is_file()
        and not args.output.read_text(encoding="utf-8", errors="ignore").lstrip().startswith("# Auto-generated by nox-display-profile")
    ):
        return 0

    args.output.parent.mkdir(parents=True, exist_ok=True)
    tmp = args.output.with_suffix(".toml.tmp")
    tmp.write_text(content, encoding="utf-8")
    os.replace(tmp, args.output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
