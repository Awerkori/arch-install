[Unit]
Description=Nox Archinstall First Boot Finalization
After=network-online.target local-fs.target systemd-udevd.service
Wants=network-online.target
ConditionPathExists=!/var/lib/nox-archinstall/first-boot.done

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/nox/nox-first-boot
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
